# Checked-in, non-secret Android CI configuration. Workflow code reads this only
# after checking out the requested commit, so each promoted artifact is fully
# described by the immutable commit that produced it.
ANDROID_MODULE=app
JAVA_VERSION=17
ANDROID_COMPILE_SDK=36
ANDROID_BUILD_TOOLS=36.0.0
APPREVEAL_REPOSITORY=infinite-toast-labs/appreveal-toastlift
APPREVEAL_COMMIT=4056cbb1d80eb45a17cd09ab86c90373d27812f8
DEBUG_GRADLE_TASKS=':app:testDebugUnitTest :app:lintDebug :app:assembleDebug'
STAGING_GRADLE_TASKS=':app:testStagingUnitTest :app:testReleaseUnitTest :app:lintRelease :app:assembleStaging'
PRODUCTION_GRADLE_TASKS=':app:testStagingUnitTest :app:testReleaseUnitTest :app:lintRelease'
ZSTORE_GRADLE_TASKS=':app:testZstoreUnitTest :app:lintZstore :app:assembleZstore'
DEBUG_APK_PATH=app/build/outputs/apk/debug/app-debug.apk
STAGING_APK_PATH=app/build/outputs/apk/staging/app-staging.apk
RELEASE_AAB_PATH=app/build/outputs/bundle/release/app-release.aab
ZSTORE_APK_PATH=app/build/outputs/apk/zstore/app-zstore-unsigned.apk
ZSTORE_PACKAGE_NAME=dev.toastlabs.toastlift.zstore
STAGING_ARTIFACT_RETENTION_DAYS=30
PRODUCTION_ARTIFACT_RETENTION_DAYS=30
